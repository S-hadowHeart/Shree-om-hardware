@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-dashboard {
        min-height: 100vh;
        background-color: #f9fafb;
    }

    .dashboard-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* Header */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

    .dashboard-header h1 {
        font-size: 1.875rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .dashboard-header p {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0.25rem 0 0 0;
    }

    .btn-logout {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        color: #374151;
        text-decoration: none;
        transition: color 0.2s;
    }

    .btn-logout:hover {
        color: #111827;
    }

    /* Navigation Cards */
    .dashboard-nav {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .nav-item {
        padding: 1.5rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
    }

    .nav-item.active {
        background-color: #f97316;
        color: white;
    }

    .nav-item:not(.active) {
        background-color: white;
        border: 1px solid #e5e7eb;
        color: #111827;
    }

    .nav-item:not(.active):hover {
        background-color: #f9fafb;
    }

    .nav-item span {
        display: block;
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .nav-item h3 {
        font-size: 0.875rem;
        font-weight: 600;
        margin: 0;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        padding: 1.5rem;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
    }

    .stat-card-inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .stat-content h3 {
        font-size: 0.75rem;
        color: #6b7280;
        margin: 0 0 0.25rem 0;
        font-weight: 500;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .stat-change {
        font-size: 0.75rem;
        margin-top: 0.25rem;
        display: block;
    }

    .stat-change.positive {
        color: #16a34a;
    }

    .stat-icon {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    /* Dashboard Content */
    .dashboard-content {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .content-section {
        background: white;
        padding: 1.5rem;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
    }

    .content-section h2 {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 1rem 0;
    }

    /* Orders List */
    .orders-list {
        display: flex;
        flex-direction: column;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 1rem;
    }

    .order-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .order-item strong {
        font-size: 0.875rem;
        color: #111827;
        display: block;
        font-weight: 600;
    }

    .order-item p {
        font-size: 0.75rem;
        color: #6b7280;
        margin: 0.25rem 0 0 0;
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-weight: 500;
        background-color: #dcfce7;
        color: #15803d;
    }

    /* Stock Alerts */
    .stock-alerts {
        display: flex;
        flex-direction: column;
    }

    .stock-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 1rem;
    }

    .stock-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .stock-item strong {
        font-size: 0.875rem;
        color: #111827;
        display: block;
        font-weight: 600;
    }

    .stock-item p {
        font-size: 0.75rem;
        color: #6b7280;
        margin: 0.25rem 0 0 0;
    }

    .btn-reorder {
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.25rem;
        background: white;
        cursor: pointer;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .btn-reorder:hover {
        background-color: #f9fafb;
    }
</style>

<div class="admin-dashboard">
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div>
                <h1>Admin Dashboard</h1>
                <p>Welcome back, Admin User</p>
            </div>
            <a href="/Account/Logout" class="btn-logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Logout
            </a>
        </div>

        <!-- Navigation Cards -->
        <div class="dashboard-nav">
            <a href="/Admin/Dashboard" class="nav-item active">
                <span>📊</span>
                <h3>Dashboard</h3>
            </a>
            <a href="/Admin/Products" class="nav-item">
                <span>📦</span>
                <h3>Products</h3>
            </a>
            <a href="/Admin/Orders" class="nav-item">
                <span>🛒</span>
                <h3>Orders</h3>
            </a>
            <a href="/Admin/Users" class="nav-item">
                <span>👥</span>
                <h3>Users</h3>
            </a>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-inner">
                    <div class="stat-content">
                        <h3>Total Sales</h3>
                        <p class="stat-value">₹@ViewBag.TotalSales.ToString("N0")</p>
                        <span class="stat-change positive">+12% from last month</span>
                    </div>
                    <div class="stat-icon" style="background: #fed7aa; color: #ea580c;">₹</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-card-inner">
                    <div class="stat-content">
                        <h3>Total Orders</h3>
                        <p class="stat-value">@ViewBag.TotalOrders.ToString("N0")</p>
                    </div>
                    <div class="stat-icon" style="background: #bfdbfe; color: #2563eb;">🛒</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-card-inner">
                    <div class="stat-content">
                        <h3>Total Users</h3>
                        <p class="stat-value">@ViewBag.TotalUsers</p>
                    </div>
                    <div class="stat-icon" style="background: #bbf7d0; color: #16a34a;">👥</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-card-inner">
                    <div class="stat-content">
                        <h3>Total Products</h3>
                        <p class="stat-value">@ViewBag.TotalProducts</p>
                    </div>
                    <div class="stat-icon" style="background: #e9d5ff; color: #9333ea;">📦</div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="dashboard-content">
            <div class="content-section">
                <h2>Recent Orders</h2>
                <div class="orders-list">
                    @foreach (var order in ViewBag.RecentOrders)
                    {
                        <div class="order-item">
                            <div>
                                <strong>Order #@order.OrderNumber</strong>
                                <p>@order.ItemCount items • ₹@order.TotalAmount.ToString("N0")</p>
                            </div>
                            <span class="status-badge">@order.Status</span>
                        </div>
                    }
                </div>
            </div>

            <div class="content-section">
                <h2>Low Stock Alerts</h2>
                <div class="stock-alerts">
                    @foreach (var product in ViewBag.LowStockProducts)
                    {
                        <div class="stock-item">
                            <div>
                                <strong>@product.Name</strong>
                                <p>Only @product.Stock units left</p>
                            </div>
                            <button class="btn-reorder">Reorder</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
