@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-wrapper">

    <!-- Header -->
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem;">
        <div>
            <h1 class="admin-page-title">Admin Dashboard</h1>
            <p class="admin-page-subtitle">Welcome back, Admin User</p>
        </div>
        <a href="/" class="btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Logout
        </a>
    </div>

    <!-- Nav Cards -->
    <div class="admin-nav-grid">
        <a href="@Url.Action("Dashboard","Admin")" class="admin-nav-card active">
            <svg class="admin-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Dashboard
        </a>
        <a href="@Url.Action("Products","Admin")" class="admin-nav-card">
            <svg class="admin-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            Products
        </a>
        <a href="@Url.Action("Orders","Admin")" class="admin-nav-card">
            <svg class="admin-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            Orders
        </a>
        <a href="@Url.Action("Users","Admin")" class="admin-nav-card">
            <svg class="admin-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Users
        </a>
    </div>

    <!-- Stat Cards -->
    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <div>
                <p class="admin-stat-label">Total Sales</p>
                <p class="admin-stat-value" style="color:#f97316;">&#8377;@ViewBag.TotalSales.ToString("N0")</p>
                <p class="admin-stat-change text-green">+12% from last month</p>
            </div>
            <div class="admin-stat-icon icon-orange">&#8377;</div>
        </div>
        <div class="admin-stat-card">
            <div>
                <p class="admin-stat-label">Total Orders</p>
                <p class="admin-stat-value">@ViewBag.TotalOrders</p>
            </div>
            <div class="admin-stat-icon icon-blue">
                <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
        </div>
        <div class="admin-stat-card">
            <div>
                <p class="admin-stat-label">Total Users</p>
                <p class="admin-stat-value">@ViewBag.TotalUsers</p>
            </div>
            <div class="admin-stat-icon icon-green">
                <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
        </div>
        <div class="admin-stat-card">
            <div>
                <p class="admin-stat-label">Total Products</p>
                <p class="admin-stat-value">@ViewBag.TotalProducts</p>
            </div>
            <div class="admin-stat-icon icon-purple">
                <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            </div>
        </div>
    </div>

    <!-- Two-col Section -->
    <div class="admin-two-col">

        <!-- Recent Orders -->
        <div class="admin-panel">
            <div class="admin-panel-body">
                <h3 class="admin-panel-title">Recent Orders</h3>
                @foreach (var order in ViewBag.RecentOrders)
                {
                    string badgeClass = order.Status switch {
                        "Delivered"  => "badge-green",
                        "Shipped"    => "badge-blue",
                        "Processing" => "badge-yellow",
                        _            => "badge-gray"
                    };
                    <div class="admin-list-item">
                        <div>
                            <p class="admin-list-item-title">Order #@order.OrderNumber</p>
                            <p class="admin-list-item-sub">@order.ItemCount items &bull; &#8377;@order.TotalAmount.ToString("N0")</p>
                        </div>
                        <span class="badge @badgeClass">@order.Status</span>
                    </div>
                }
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="admin-panel">
            <div class="admin-panel-body">
                <h3 class="admin-panel-title">Low Stock Alerts</h3>
                @foreach (var product in ViewBag.LowStockProducts)
                {
                    <div class="admin-list-item">
                        <div>
                            <p class="admin-list-item-title">@product.Name</p>
                            <p class="admin-list-item-sub">Only @product.Stock units left</p>
                        </div>
                        <button class="btn-outline" style="font-size:0.75rem; padding:0.35rem 0.75rem;">Reorder</button>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
