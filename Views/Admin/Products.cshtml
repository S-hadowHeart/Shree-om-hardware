@model IEnumerable<shree_om.Models.Product>
@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-wrapper">

    <!-- Header -->
    <div style="margin-bottom:1.5rem;">
        <h1 class="admin-page-title">Product Management</h1>
        <p class="admin-page-subtitle">Manage your product inventory</p>
    </div>

    <!-- Search + Add -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <div class="admin-search-wrap">
            <svg class="admin-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="prodSearch" placeholder="Search products..." oninput="filterProducts()" />
        </div>
        <a href="@Url.Action("AddProduct","Admin")" class="btn-orange">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Product
        </a>
    </div>

    <!-- Table -->
    <div class="admin-table-wrap">
        <table class="admin-table" id="prodTable">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr data-name="@p.Name.ToLower()" data-cat="@(p.Category?.Name.ToLower())">
                        <td><div class="prod-img">IMG</div></td>
                        <td style="font-weight:500;">@p.Name</td>
                        <td class="muted">@p.Category?.Name</td>
                        <td style="font-weight:500;">&#8377;@p.Price.ToString("N0")</td>
                        <td>@p.Stock</td>
                        <td>
                            <div style="display:flex; gap:0.5rem;">
                                <a href="@Url.Action("EditProduct","Admin", new { id = p.Id })" class="btn-icon" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form method="post" action="@Url.Action("DeleteProduct","Admin", new { id = p.Id })" style="display:inline;">
                                    <button type="submit" class="btn-icon btn-delete" title="Delete" onclick="return confirm('Delete this product?')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Back -->
    <div style="margin-top:1.5rem;">
        <a href="@Url.Action("Dashboard","Admin")" class="btn-outline">&#8592; Back to Dashboard</a>
    </div>

</div>

@section Scripts {
<script>
function filterProducts() {
    var q = document.getElementById('prodSearch').value.toLowerCase();
    document.querySelectorAll('#prodTable tbody tr').forEach(function(row) {
        var name = row.dataset.name || '';
        var cat  = row.dataset.cat  || '';
        row.style.display = (name.includes(q) || cat.includes(q)) ? '' : 'none';
    });
}
</script>
}
