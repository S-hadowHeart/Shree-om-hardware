@model shree_om.Models.Product
@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-form">
    <h1>Edit Product</h1>

    <form method="post" action="/Admin/EditProduct">
        <input type="hidden" name="Id" value="@Model.Id">
        <input type="hidden" name="CreatedAt" value="@Model.CreatedAt">

        <div class="form-row">
            <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="Name" value="@Model.Name" required>
            </div>
            <div class="form-group">
                <label>SKU</label>
                <input type="text" value="SH-DH-001" readonly>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Category</label>
                <select name="CategoryId" required>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        if (cat.Id == Model.CategoryId)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Stock</label>
                <input type="number" name="Stock" value="@Model.Stock" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Price (₹)</label>
                <input type="number" name="Price" value="@Model.Price" step="0.01" required>
            </div>
            <div class="form-group">
                <label>Sale Price (₹) <span>(Optional)</span></label>
                <input type="number" name="OriginalPrice" value="@Model.OriginalPrice" step="0.01">
            </div>
        </div>

        <div class="form-group">
            <label>Image URL</label>
            <div class="image-input">
                <input type="text" name="ImageUrl" value="@Model.ImageUrl">
                <button type="button" class="btn-select">Select</button>
            </div>
        </div>

        <div class="form-group">
            <label>Short Description</label>
            <input type="text" value="@Model.Description">
        </div>

        <div class="form-group">
            <label>Full Description</label>
            <textarea name="Description" rows="4">@Model.Description</textarea>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Material</label>
                <input type="text" value="Stainless Steel 304">
            </div>
            <div class="form-group">
                <label>Finish</label>
                <input type="text" value="Chrome">
            </div>
        </div>

        <div class="form-actions">
            <a href="/Admin/Products" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-primary">Update Product</button>
        </div>
    </form>
</div>
